  "fatigue_rules": {
    "1": {
      "volume": 1.15,
      "intensity": "haute",
      "rest": "court",
      "impact": true
    },
    "2": {
      "volume": 1.05,
      "intensity": "soutenue",
      "rest": "normal",
      "impact": true
    },
    "3": {
      "volume": 1.0,
      "intensity": "modérée",
      "rest": "normal",
      "impact": true
    },
    "4": {
      "volume": 0.75,
      "intensity": "contrôlée",
      "rest": "long",
      "impact": false
    },
    "5": {
      "volume": 0.55,
      "intensity": "récupération active",
      "rest": "long",
      "impact": false
    }
