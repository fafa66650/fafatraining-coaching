      "core": "35 sec",
      "finisher": "6 min"
    },
    "avance": {
      "activation": "50 sec",
      "bloc": "4-5 tours",
      "core": "40 sec",
      "finisher": "8 min"
    },
    "expert": {
      "activation": "60 sec",
      "bloc": "5 tours + intensité",
      "core": "45 sec",
      "finisher": "10 min"
    }
